{
  "name": "starrypad-interface",
  "version": "1.0.0",
  "description": "Control the Donner STARRYPAD from Node.js and the browser: pad LED colours over SysEx, live MIDI view, reverse-engineered protocol spec",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "colors": "node tools/pad-colors.js",
    "probe": "node tools/pad-probe.js",
    "proxy": "node tools/midi-proxy.js",
    "animate": "node tools/pad-animate.js",
    "monitor": "node tools/midi-monitor.js"
  },
  "keywords": [
    "midi",
    "sysex",
    "starrypad",
    "donner",
    "drum-pad",
    "led",
    "websocket"
  ],
  "author": "Ingo Eichhorst",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingo-eichhorst/starrypad-interface.git"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "midi": "^2.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
